    <Compile Include="Assets\Scripts\Interaction\RotatingBridgeMechanism.cs" />
    <Compile Remove="Assets\Scripts\Map\MiniMapWallGroup.cs" />
    <Compile Include="Assets\Scripts\Map\MiniMapWallGroup.cs" />
  </ItemGroup>
</Project>
