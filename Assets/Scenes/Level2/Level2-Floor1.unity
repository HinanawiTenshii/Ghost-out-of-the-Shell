MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8801241000}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5611d3acb49e8a0e731fca88a298d4e7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  speakerName: "\u8D5D\u54C1\u5DE5\u5320"
  startNodeId: start
  questProgression: {fileID: 8801241002}
  actorAgreement: {fileID: 0}
  arenaChallenge: {fileID: 0}
  dialogueMemoryId: level2.dialogue.counterfeit_craftsman
  interactionDistance: 3
  displayFont: {fileID: 12800000, guid: 292af55397c443f6a5d7774297dac481, type: 3}
  dimOpacity: 0.65
  nodes:
  - id: start
    text: "\u60F3\u8FC7\u8BD5\u70BC\u5927\u95E8\uFF1F\u522B\u88AB\u90A3\u679A\u8BC1\u660E\u7684\u82B1\u6837\u552C\u4F4F\u4E86\u3002\n\u796D\u575B\u4E0D\u8BA4\u8BC6\u8C01\u7B7E\u53D1\u7684\u51ED\u8BC1\uFF0C\u4E5F\u4E0D\u5728\u4E4E\u4F69\u6234\u5B83\u7684\u662F\u8C01\u3002\u5B83\u8BA4\u7684\uFF0C\u662F\u5D4C\u5728\u4E2D\u592E\u90A3\u9897\u91D1\u8272\u5B9D\u77F3\u91CC\u7684\u9B54\u529B\u3002\n\u5F04\u5230\u4E00\u9897\u91D1\u8272\u5B9D\u77F3\uFF0C\u6211\u5C31\u80FD\u66FF\u4F60\u6253\u4E2A\u6258\uFF0C\u505A\u4E00\u679A\u8D5D\u54C1\u3002\u6837\u5B50\u4E5F\u8BB8\u5BD2\u9178\u4E9B\uFF0C\u53EF\u5728\u796D\u575B\u773C\u91CC\uFF0C\u5B83\u548C\u6B63\u54C1\u6CA1\u4EC0\u4E48\u4E24\u6837\u3002"
    differentActorOpeningText: "\u5148\u524D\u6765\u6253\u542C\u7684\u4EBA\u4E0D\u662F\u4F60\u3002\u600E\u4E48\uFF0C\u8BD5\u70BC\u5927\u95E8\u540E\u9762\u771F\u6709\u90A3\u4E48\u591A\u597D\u4E1C\u897F\uFF1F\n\u6211\u53EA\u8BF4\u4E00\u6B21\uFF1A\u796D\u575B\u8BA4\u7684\u662F\u8BC1\u660E\u4E2D\u592E\u90A3\u9897\u91D1\u8272\u5B9D\u77F3\u7684\u9B54\u529B\uFF0C\u4E0D\u8BA4\u7B7E\u53D1\u8005\uFF0C\u4E5F\u4E0D\u8BA4\u4F69\u6234\u8005\u3002\u5E26\u4E00\u9897\u771F\u7684\u91D1\u8272\u5B9D\u77F3\u6765\uFF0C\u6211\u5C31\u80FD\u6253\u4E2A\u6258\uFF0C\u505A\u51FA\u4E00\u679A\u8DB3\u4EE5\u9A97\u8FC7\u796D\u575B\u7684\u8D5D\u54C1\u3002\u6837\u5B50\u5BD2\u9178\u4E9B\uFF0C\u4E0D\u59A8\u788D\u5F00\u95E8\u3002"
    choices:
    - text: "\u518D\u89C1\u3002"
      action: 1
      nextNodeId: 
      effect: {fileID: 0}
      onSelected:
        m_PersistentCalls:
          m_Calls: []
    - text: "\u6211\u5E94\u8BE5\u53BB\u54EA\u91CC\u5F04\u5230\u91D1\u8272\u5B9D\u77F3\uFF1F"
      action: 0
      nextNodeId: gem_needed
      effect: {fileID: 8801241003}
      onSelected:
        m_PersistentCalls:
          m_Calls: []
  - id: gem_needed
    text: "\u53BB\u884C\u5546\u5E02\u573A\u7684\u4E8C\u5C42\u627E\u627E\u3002\u90A3\u513F\u6709\u4E2A\u7A7F\u6DF1\u84DD\u8272\u8863\u670D\u7684\u5B9D\u77F3\u5546\u4EBA\uFF0C\u5E38\u628A\u4E9B\u7A00\u7F55\u77F3\u5934\u85CF\u5728\u67DC\u5E95\u3002\n\u4ED6\u6216\u8BB8\u6709\u91D1\u8272\u5B9D\u77F3\u3002\u95EE\u6E05\u4EF7\u94B1\u518D\u638F\u94B1\u2014\u2014\u7A00\u7F55\u4E1C\u897F\u843D\u5230\u4ED6\u624B\u91CC\uFF0C\u603B\u8981\u8D35\u4E0A\u51E0\u5206\u3002\n\u628A\u5B9D\u77F3\u5E26\u56DE\u6765\uFF0C\u6211\u5C31\u66FF\u4F60\u628A\u8BC1\u660E\u505A\u51FA\u6765\u3002"
    differentActorOpeningText: "\u6362\u4E86\u4E2A\u4EBA\u6765\uFF1F\u90A3\u5C31\u628A\u8BDD\u63A5\u4E0A\uFF1A\u505A\u90A3\u679A\u8BC1\u660E\uFF0C\u8FD8\u7F3A\u4E00\u9897\u91D1\u8272\u5B9D\u77F3\u3002\u8C01\u5E26\u6765\uFF0C\u6211\u5C31\u628A\u6D3B\u4EA4\u7ED9\u8C01\u3002\n\u53BB\u884C\u5546\u5E02\u573A\u4E8C\u5C42\u627E\u7A7F\u6DF1\u84DD\u8272\u8863\u670D\u7684\u5B9D\u77F3\u5546\u4EBA\u3002\u4ED6\u5E38\u628A\u7A00\u7F55\u8D27\u85CF\u5728\u67DC\u5E95\uFF0C\u6216\u8BB8\u5C31\u6709\u4F60\u8981\u7684\u4E1C\u897F\u3002\u95EE\u6E05\u4EF7\u94B1\u518D\u638F\u94B1\uFF0C\u90A3\u5BB6\u4F19\u53EF\u4E0D\u4FBF\u5B9C\u3002"
    choices:
    - text: "\u518D\u89C1\u3002"
      action: 1
      nextNodeId: 
      effect: {fileID: 0}
