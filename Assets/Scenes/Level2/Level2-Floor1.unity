    - target: {fileID: 918620450781230005, guid: c76db960b6ca4cefa2a91739367713a5, type: 3}
      propertyPath: documentText
      value: "\u4E16\u95F4\u6709\u95E8\uFF0C\u4E0D\u901A\u6B64\u4E16\u3002\u6B32\u8BF7\u57DF\u5916\u6765\u5BA2\u964D\u4E34\uFF0C\u987B\u5907\u9F50\u516D\u628A\u94A5\u5319\u3002\n\u94A5\u5319\u4E0D\u662F\u91D1\u94C1\uFF0C\u800C\u662F\u4EE5\u4E0B\u516D\u4EBA\u7684\u7075\u9B42\uFF1A\n\n\u57CE\u4E2D\u7684\u5927\u4E3B\u6559\uFF1B\u8EAB\u7740\u91D1\u8272\u670D\u88C5\u7684\u5B88\u536B\u58EB\u5B98\uFF1B\n\u8D6B\u8D6B\u6709\u540D\u7684\u5927\u53A8\uFF1B\u5927\u5DE5\u7A0B\u5E08\uFF1B\n\u8BE1\u5F02\u5546\u4EBA\uFF1B\u6765\u81EA\u9065\u8FDC\u4E4B\u5730\u7684\u9690\u5C45\u5251\u5BA2\u3002\n\n\u987B\u4EE4\u8FD9\u516D\u4EBA\u5728\u6CD5\u9635\u7684\u77E9\u5F62\u8303\u56F4\u5185\u6B92\u547D\uFF0C\u6BCF\u732E\u4E00\u9B42\uFF0C\u4FBF\u70B9\u4EAE\u4E00\u679A\u6C34\u6676\u3002\u5728\u8303\u56F4\u5916\u6740\u6B7B\u4ED6\u4EEC\uFF0C\u4EEA\u5F0F\u4E0D\u4F1A\u63A5\u7EB3\u3002\n\u516D\u679A\u6C34\u6676\u5C3D\u6570\u4EAE\u8D77\uFF0C\u57DF\u5916\u6765\u5BA2\u4FBF\u4F1A\u5728\u6CD5\u9635\u4E2D\u592E\u73B0\u8EAB\u3002\n\u5207\u8BB0\uFF1A\u95E8\u4F1A\u5E94\u7EA6\u800C\u5F00\uFF0C\u6765\u5BA2\u5374\u672A\u5FC5\u5FC3\u6000\u611F\u6FC0\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 918620450781230005, guid: c76db960b6ca4cefa2a91739367713a5, type: 3}
      propertyPath: journalEntryId
      value: level2.summoning
      objectReference: {fileID: 0}
    - target: {fileID: 918620450781230005, guid: c76db960b6ca4cefa2a91739367713a5, type: 3}
      propertyPath: journalEntryTitle
      value: "\u516D\u628A\u94A5\u5319"
