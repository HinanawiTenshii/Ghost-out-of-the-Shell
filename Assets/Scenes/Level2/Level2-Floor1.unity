        m_PersistentCalls:
          m_Calls: []
  - id: finished
    text: "\u597D\u4E86\uFF0C\u62FF\u7740\u3002\u91D1\u5C5E\u6258\u7C97\u7CD9\u4E86\u70B9\uFF0C\u53EF\u5B9D\u77F3\u7A33\u7A33\u5F53\u5F53\uFF0C\u4E00\u5206\u9B54\u529B\u4E5F\u6CA1\u5C11\u3002\n\u522B\u62FF\u53BB\u7ED9\u4EBA\u7EC6\u770B\uFF0C\u76F4\u63A5\u4F9B\u5230\u8BD5\u70BC\u5927\u95E8\u7684\u796D\u575B\u4E0A\u3002\u5B83\u53EA\u8BA4\u8FD9\u9897\u77F3\u5934\uFF0C\u4E0D\u4F1A\u6311\u6211\u7684\u624B\u827A\u3002\n\u5FEB\u53BB\u5427\u3002\u95E8\u5F00\u4EE5\u540E\uFF0C\u53EF\u5C31\u5F97\u9760\u4F60\u81EA\u5DF1\u4E86\u3002"
    differentActorOpeningText: "\u4F60\u4E0D\u662F\u5148\u524D\u90A3\u4F4D\u5BA2\u4EBA\u3002\u90A3\u679A\u8D5D\u54C1\u8BD5\u70BC\u8BC1\u660E\u5DF2\u7ECF\u505A\u597D\uFF0C\u4E5F\u4EA4\u51FA\u53BB\u4E86\uFF0C\u6211\u53EF\u4E0D\u4F1A\u518D\u505A\u4E00\u679A\u3002\n\u82E5\u4E1C\u897F\u5982\u4ECA\u5728\u4F60\u624B\u4E0A\uFF0C\u5C31\u76F4\u63A5\u4F9B\u5230\u8BD5\u70BC\u5927\u95E8\u7684\u796D\u575B\u4E0A\u3002\u5B83\u8BA4\u7684\u662F\u91D1\u8272\u5B9D\u77F3\u91CC\u7684\u9B54\u529B\uFF0C\u4E0D\u662F\u62FF\u7740\u5B83\u7684\u90A3\u5F20\u8138\u3002\n\u522B\u62FF\u7ED9\u65C1\u4EBA\u7EC6\u770B\uFF0C\u4E5F\u522B\u5230\u5904\u63D0\u6211\u7684\u540D\u5B57\u3002"
    choices:
