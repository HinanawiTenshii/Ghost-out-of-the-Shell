  dimOpacity: 0.65
  nodes:
  - id: start
    text: "\u60F3\u5BF9\u4ED8\u57CE\u5916\u90A3\u6761\u6C99\u866B\uFF1F\u522B\u6025\u7740\u62FF\u81EA\u5DF1\u53BB\u5582\u5B83\u3002\u4F60\u9700\u8981\u8BF1\u9975\u70B8\u5F39\uFF0C\u8BA9\u5B83\u628A\u771F\u6B63\u8981\u547D\u7684\u4E1C\u897F\u541E\u8FDB\u809A\u5B50\u91CC\u3002\n\u6211\u4F1A\u505A\u8FD9\u79CD\u70B8\u5F39\uFF0C\u53EF\u60DC\u7F3A\u4E86\u4E00\u5957\u5408\u6210\u5DE5\u5177\u3002\u90A3\u4E1C\u897F\u5982\u4ECA\u5C31\u5728\u57CE\u9547\u7684\u8981\u585E\u91CC\u3002\u4F60\u66FF\u6211\u53D6\u56DE\u6765\uFF0C\u6211\u5C31\u80FD\u66FF\u4F60\u5236\u4F5C\u3002"
    differentActorOpeningText: "\u2026\u2026\u4E0D\u662F\u521A\u624D\u90A3\u5F20\u8138\u3002\u4F60\u4E5F\u60E6\u8BB0\u7740\u57CE\u5916\u7684\u6C99\u866B\uFF1F\u60F3\u6D3B\u7740\u56DE\u6765\uFF0C\u5C31\u522B\u62FF\u81EA\u5DF1\u5F53\u9975\u3002\u8BF1\u9975\u70B8\u5F39\u80FD\u8BA9\u5B83\u628A\u771F\u6B63\u8981\u547D\u7684\u4E1C\u897F\u541E\u8FDB\u809A\u5B50\u91CC\u3002\n\u6211\u4F1A\u505A\uFF0C\u53EF\u624B\u5934\u7F3A\u4E00\u5957\u5408\u6210\u5DE5\u5177\u3002\u4E1C\u897F\u5C31\u5728\u57CE\u9547\u7684\u8981\u585E\u91CC\u3002\u8C01\u628A\u5B83\u5E26\u6765\uFF0C\u6211\u5C31\u66FF\u8C01\u5F00\u5DE5\u3002"
