  - id: shop
    text: "\u5DE5\u5177\u5DF2\u7ECF\u9F50\u4E86\uFF0C\u60F3\u8981\u8BF1\u9975\u70B8\u5F39\u5417\uFF1F\u516D\u679A\u91D1\u5E01\u4E00\u9897\u3002\u82E5\u4F60\u81EA\u5907\u4E00\u9897\u666E\u901A\u70B8\u5F39\uFF0C\u518D\u6DFB\u4E00\u679A\u91D1\u5E01\uFF0C\u6211\u5C31\u66FF\u4F60\u6539\u9020\u3002\u53EA\u8981\u4ED8\u5F97\u8D77\uFF0C\u6211\u8FD9\u91CC\u968F\u65F6\u53EF\u4EE5\u505A\u3002"
    differentActorOpeningText: "\u8FD9\u56DE\u6362\u4EBA\u6765\u4E70\u4E86\uFF1F\u65E0\u59A8\uFF0C\u5408\u6210\u5DE5\u5177\u5DF2\u7ECF\u6709\u4EBA\u9001\u6765\uFF0C\u6211\u8FD9\u91CC\u7167\u5E38\u5F00\u5DE5\u3002\n\u8BF1\u9975\u70B8\u5F39\uFF0C\u516D\u679A\u91D1\u5E01\u4E00\u9897\u3002\u81EA\u5907\u4E00\u9897\u666E\u901A\u70B8\u5F39\uFF0C\u518D\u6DFB\u4E00\u679A\u91D1\u5E01\uFF0C\u4E5F\u80FD\u66FF\u4F60\u6539\u9020\u3002\u8D27\u7ED9\u4ED8\u94B1\u7684\u4EBA\uFF0C\u81F3\u4E8E\u8C01\u53BB\u5582\u6C99\u866B\uFF0C\u6211\u4E0D\u8FC7\u95EE\u3002"
    choices:
    - text: "\u518D\u89C1\u3002"
      action: 1
      nextNodeId: 
      effect: {fileID: 0}
      onSelected:
        m_PersistentCalls:
          m_Calls: []
    - text: "\u8D2D\u4E70\u8BF1\u9975\u70B8\u5F39X1\uFF08\u6D88\u80176\u91D1\u5E01\uFF09"
      action: 0
      nextNodeId: shop
      effect: {fileID: 1126622796}
      onSelected:
        m_PersistentCalls:
          m_Calls: []
    - text: "\u8D2D\u4E70\u8BF1\u9975\u70B8\u5F39X1\uFF08\u6D88\u80171\u4E2A\u666E\u901A\u70B8\u5F39\u4E0E1\u91D1\u5E01\uFF09"
      action: 0
      nextNodeId: shop
      effect: {fileID: 1126622797}
      onSelected:
        m_PersistentCalls:
          m_Calls: []
  - id: before_hunt
    text: "\u751F\u9762\u5B54\uFF0C\u60F3\u4E70\u70B9\u4EC0\u4E48\uFF1F\u2026\u2026\u5148\u522B\u6025\u7740\u638F\u94B1\u3002\u8FD1\u6765\u57CE\u5916\u4E0D\u592A\u5E73\uFF0C\u8FDE\u8001\u7EC3\u7684\u5192\u9669\u8005\u90FD\u6CA1\u80FD\u56DE\u6765\u3002\n\n\u53BB\u770B\u770B\u57CE\u91CC\u7684\u6C99\u866B\u516C\u544A\u5427\u3002\u5F04\u6E05\u695A\u9EC4\u6C99\u5E95\u4E0B\u7A76\u7ADF\u85CF\u7740\u4EC0\u4E48\uFF0C\u518D\u51B3\u5B9A\u81EA\u5DF1\u9700\u8981\u4EC0\u4E48\u3002\u6211\u8FD9\u91CC\u7684\u8D27\uFF0C\u53EF\u4E0D\u9002\u5408\u53EA\u51ED\u4E00\u65F6\u597D\u5947\u5C31\u5F80\u5916\u8DD1\u7684\u4EBA\u3002"
    differentActorOpeningText: "\u53C8\u6362\u4E86\u4E00\u5F20\u8138\uFF1F\u65E0\u59A8\uFF0C\u4E70\u5356\u8BA4\u7684\u662F\u94B1\u3002\u4E0D\u8FC7\u4F60\u82E5\u6253\u7B97\u51FA\u57CE\uFF0C\u6700\u597D\u5148\u628A\u57CE\u91CC\u7684\u6C99\u866B\u516C\u544A\u8BFB\u660E\u767D\u3002\n\n\u9EC4\u6C99\u5E95\u4E0B\u7684\u4E1C\u897F\u4E0D\u8BA4\u4EBA\uFF0C\u4E5F\u4E0D\u8BB2\u4EF7\u3002\u7B49\u4F60\u5F04\u6E05\u695A\u81EA\u5DF1\u8981\u9762\u5BF9\u4EC0\u4E48\uFF0C\u6211\u4EEC\u518D\u8C08\u3002"
    choices:
    - text: "\u518D\u89C1\uFF0C\u6211\u5148\u53BB\u770B\u770B\u516C\u544A\u3002"
      action: 1
