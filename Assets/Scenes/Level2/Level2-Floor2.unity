      action: 1
      nextNodeId: 
      effect: {fileID: 0}
      onSelected:
        m_PersistentCalls:
          m_Calls: []
    - text: "\u4F60\u8FD9\u91CC\u5356\u91D1\u8272\u5B9D\u77F3\u5417\uFF1F"
      action: 0
      nextNodeId: gold_price
