  dimOpacity: 0.65
  nodes:
  - id: start
    text: "\u60F3\u4E70\u70B9\u5B9D\u77F3\uFF1F\u6211\u8FD9\u91CC\u7684\u8D27\uFF0C\u6210\u8272\u548C\u6765\u8DEF\u90FD\u6709\u8BB2\u7A76\u3002\n\u88C5\u5728\u6212\u6307\u4E0A\u7ED9\u4EBA\u770B\uFF0C\u8FD8\u662F\u88C5\u8FDB\u673A\u5173\u91CC\u505A\u522B\u7684\u4E8B\uFF1F\u8BF4\u6E05\u4F60\u8981\u54EA\u4E00\u79CD\uFF0C\u54B1\u4EEC\u518D\u8C08\u4EF7\u94B1\u3002"
    differentActorOpeningText: "\u521A\u624D\u7AD9\u5728\u67DC\u53F0\u524D\u7684\uFF0C\u53EF\u4E0D\u662F\u4F60\u3002\u670B\u53CB\u4ECB\u7ECD\u6765\u7684\uFF1F\n\u6211\u8BA4\u5F97\u8138\uFF0C\u4F46\u4E70\u5356\u53EA\u8BA4\u8D27\u4E0E\u91D1\u5E01\u3002\u60F3\u627E\u88C5\u70B9\u8863\u9886\u7684\u5B9D\u77F3\uFF0C\u8FD8\u662F\u4F9B\u673A\u5173\u4F7F\u7528\u7684\u77F3\u5934\uFF1F\u8BF4\u6E05\u695A\uFF0C\u54B1\u4EEC\u518D\u8C08\u4EF7\u94B1\u3002"
