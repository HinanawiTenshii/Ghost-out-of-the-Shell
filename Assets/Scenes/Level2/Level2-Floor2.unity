    - target: {fileID: 918620450781230005, guid: c76db960b6ca4cefa2a91739367713a5, type: 3}
      propertyPath: documentText
      value: "\u5DE1\u903B\u961F\u5E94\u6025\u9884\u6848\xB7\u62A4\u536B\u4F20\u9605\n\n\u9A91\u58EB\u957F\u5916\u51FA\uFF0C\u4E09\u540D\u5723\u9A91\u58EB\u968F\u884C\u3002\u82E5\u591A\u4EBA\u8D1F\u4F24\u3001\u9635\u5F62\u53D7\u632B\uFF0C\u5168\u961F\u5373\u523B\u52A0\u901F\u64A4\u5F80\u5C31\u8FD1\u5B89\u5168\u5C4B\uFF0C\u4E0D\u5F97\u8FFD\u654C\u8BEF\u4E8B\u3002\n\n\u9A91\u58EB\u957F\u7559\u5B88\u5C4B\u5185\uFF0C\u62A4\u536B\u9A7B\u5B88\u95E8\u5916\uFF1A\u5357\u5C4B\u897F\u3001\u4E1C\u3001\u5357\u4E09\u5904\u5165\u53E3\u5404\u4E00\u4EBA\uFF1B\u5317\u5C4B\u4E09\u4EBA\u540C\u5B88\u5357\u95E8\u3002\u7981\u6B62\u4EFB\u4F55\u5916\u4EBA\u8FDB\u5165\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 918620450781230005, guid: c76db960b6ca4cefa2a91739367713a5, type: 3}
      propertyPath: journalEntryId
      value: level2.knight_ambush
      objectReference: {fileID: 0}
    - target: {fileID: 918620450781230005, guid: c76db960b6ca4cefa2a91739367713a5, type: 3}
      propertyPath: journalEntryTitle
      value: "\u4E0D\u5FC5\u523A\u6740\u9A91\u58EB\u56E2\u957F"
      objectReference: {fileID: 0}
    - target: {fileID: 918620450781230005, guid: c76db960b6ca4cefa2a91739367713a5, type: 3}
      propertyPath: journalEntryDetails
      value: "\u9A91\u58EB\u957F\u7531\u4E09\u540D\u5723\u9A91\u58EB\u62A4\u9001\u3002\u5C0F\u961F\u906D\u5230\u4E25\u91CD\u88AD\u51FB\u540E\uFF0C\u4F1A\u62A4\u9001\u9A91\u58EB\u957F\u64A4\u5F80\u5B89\u5168\u5C4B\uFF0C\u5E76\u5728\u5165\u53E3\u9A7B\u5B88\u3002\u53EF\u4EE5\u573A\u666F\u4E2D\u7684\u7269\u4EF6\u5236\u9020\u88AD\u51FB\uFF0C\u518D\u8BBE\u6CD5\u8FDB\u5165\u5B89\u5168\u5C4B\u9644\u8EAB\u9A91\u58EB\u957F\uFF0C\u5229\u7528\u4ED6\u7684\u6743\u9650\u63A5\u8FD1\u8BD5\u70BC\u8BC1\u660E\u3002\u9A91\u58EB\u957F\u5FC5\u987B\u5B58\u6D3B\u3002\n\n\u5F53\u524D\u76EE\u6807\uFF1A\u5236\u9020\u4E00\u573A\u8DB3\u591F\u89C4\u6A21\u7684\u88AD\u51FB\u3002"
