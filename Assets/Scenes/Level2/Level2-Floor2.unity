          m_Calls: []
  - id: gold_price
    text: "\u91D1\u8272\u5B9D\u77F3\uFF1F\u6709\uFF0C\u4E0D\u8FC7\u5B83\u53EF\u4E0D\u662F\u62FF\u6765\u88C5\u70B9\u8863\u9886\u7684\u9EC4\u73BB\u7483\u3002\n\u5B83\u91CC\u9762\u7684\u9B54\u529B\u7A33\u5F97\u5F88\uFF0C\u7528\u6765\u7ED9\u8001\u673A\u5173\u9A8C\u660E\u51ED\u8BC1\uFF0C\u518D\u5408\u9002\u4E0D\u8FC7\u3002\n\u4E09\u5341\u679A\u91D1\u5E01\uFF0C\u4E00\u679A\u4E5F\u4E0D\u80FD\u5C11\u3002\u4F60\u4ED8\u6E05\u94B1\uFF0C\u6211\u4FBF\u628A\u5B9D\u77F3\u4EA4\u7ED9\u4F60\u3002\u81F3\u4E8E\u62FF\u5B83\u53BB\u505A\u4EC0\u4E48\uFF0C\u53EF\u522B\u7B97\u5728\u6211\u5934\u4E0A\u3002"
