  displayFont: {fileID: 12800000, guid: 292af55397c443f6a5d7774297dac481, type: 3}
  dimOpacity: 0.65
  nodes:
  - id: start
    text: "\u60F3\u5BF9\u4ED8\u57CE\u5916\u90A3\u6761\u6C99\u866B\uFF1F\u57CE\u5899\u897F\u5357\u89D2\u57CE\u697C\u4E0A\u6709\u4E00\u95E8\u81FC\u70AE\uFF0C\u70AE\u5F39\u7684\u51B2\u51FB\u8DB3\u4EE5\u628A\u5B83\u4ECE\u5730\u5E95\u6380\u51FA\u6765\u3002\u53EF\u6C99\u66B4\u4E00\u8D77\uFF0C\u4ECE\u57CE\u697C\u4E0A\u671B\u51FA\u53BB\u53EA\u5269\u4E00\u7247\u9EC4\u6C99\uFF0C\u8FDE\u866B\u5B50\u5728\u54EA\u513F\u90FD\u770B\u4E0D\u6E05\uFF0C\u8FD8\u8C08\u4EC0\u4E48\u7784\u51C6\u3002\n\n\u6240\u4EE5\u6211\u8BBE\u8BA1\u4E86\u4E00\u5957\u8FDC\u7A0B\u63A7\u5236\u88C5\u7F6E\u3002\u628A\u63A7\u5236\u5668\u88C5\u5728\u81FC\u70AE\u4E0A\uFF0C\u62FF\u7740\u9065\u63A7\u5668\u53BB\u6C99\u6F20\uFF0C\u4E00\u6309\uFF0C\u5C31\u80FD\u8BA9\u70AE\u5F39\u843D\u5230\u4F60\u53D1\u51FA\u4FE1\u53F7\u7684\u4F4D\u7F6E\u3002\u7CBE\u786E\u3001\u76F4\u63A5\u2014\u2014\u53EA\u9700\u8981\u4E00\u4E2A\u4EBA\u8089\u4FE1\u6807\u3002\n\n\u5B88\u519B\u542C\u5230\u8FD9\u91CC\u5C31\u628A\u56FE\u7EB8\u63A8\u56DE\u6765\u4E86\uFF0C\u8BF4\u4ED6\u4EEC\u62DB\u7684\u662F\u70AE\u624B\uFF0C\u4E0D\u662F\u70AE\u9776\u3002\u54FC\uFF0C\u6309\u5B8C\u4EE5\u540E\u8DD1\u5F00\u4E0D\u5C31\u884C\u4E86\uFF1F\n\n\u4F60\u8981\u662F\u80C6\u5B50\u591F\u5927\uFF0C\u5C31\u6E9C\u4E0A\u57CE\u5899\uFF0C\u628A\u63A7\u5236\u5668\u5077\u5077\u88C5\u5230\u90A3\u95E8\u81FC\u70AE\u4E0A\uFF0C\u4EB2\u81EA\u53BB\u5F53\u8FD9\u4E2A\u4FE1\u6807\u3002\u70AE\u5F39\u53EF\u4E0D\u8BA4\u4EBA\uFF0C\u6309\u4E0B\u53BB\u4EE5\u540E\u522B\u7AD9\u5728\u539F\u5730\u6B23\u8D4F\u6211\u7684\u53D1\u660E\u3002\u600E\u4E48\u6837\uFF0C\u6562\u4E0D\u6562\u8BD5\u8BD5\uFF1F"
    differentActorOpeningText: 
    choices:
    - text: "\u518D\u89C1\u3002"
      action: 1
      nextNodeId: 
      effect: {fileID: 0}
      onSelected:
        m_PersistentCalls:
          m_Calls: []
    - text: "\u63A5\u53D7\u3002\u6211\u6765\u5F53\u8FD9\u4E2A\u4FE1\u6807\u3002"
      action: 0
      nextNodeId: accepted
      effect: {fileID: 273805458}
      onSelected:
        m_PersistentCalls:
          m_Calls: []
  - id: accepted
    text: "\u597D\uFF01\u603B\u7B97\u6709\u4EBA\u61C2\u5F97\u6B23\u8D4F\u5DE5\u7A0B\u5B66\u4E86\u3002\u63A7\u5236\u5668\u5C31\u5728\u65C1\u8FB9\u7684\u4FDD\u9669\u67DC\u91CC\uFF0C\u5BC6\u7801\u662F
      1551\u3002\u53D6\u51FA\u6765\u540E\uFF0C\u5E26\u5230\u57CE\u5899\u897F\u5357\u89D2\u57CE\u697C\u7684\u81FC\u70AE\u65C1\u5B89\u88C5\uFF0C\u5C31\u80FD\u62FF\u5230\u4E0E\u5B83\u914D\u5957\u7684\u9065\u63A7\u5668\u3002\n\n\u8BB0\u4F4F\uFF0C\u9065\u63A7\u5668\u53EA\u80FD\u5728\u57CE\u5916\u6C99\u6F20\u4F7F\u7528\uFF0C\u70AE\u5F39\u7784\u51C6\u7684\u662F\u4F60\u6309\u4E0B\u6309\u94AE\u7684\u90A3\u4E00\u523B\u7AD9\u7684\u4F4D\u7F6E\u3002\u53D1\u51FA\u4FE1\u53F7\u5C31\u8D76\u5FEB\u79BB\u5F00\uFF0C\u522B\u628A\u2018\u4EBA\u8089\u4FE1\u6807\u2019\u505A\u6210\u4E00\u6B21\u6027\u7684\u3002\u8FD8\u6709\uFF0C\u522B\u8BA9\u5B88\u519B\u770B\u89C1\uFF0C\u66F4\u522B\u8BF4\u662F\u6211\u8BA9\u4F60\u53BB\u7684\u3002"
    differentActorOpeningText: 
    choices:
    - text: "\u518D\u89C1\u3002"
      action: 1
      nextNodeId: 
      effect: {fileID: 0}
      onSelected:
        m_PersistentCalls:
          m_Calls: []
  - id: reminder
    text: "\u4F60\u65E2\u7136\u62FF\u5230\u4E86\uFF0C\u5C31\u5FEB\u53BB\u5427\uFF0C\u522B\u62B1\u7740\u6211\u7684\u63A7\u5236\u5668\u5728\u8FD9\u91CC\u8F6C\u60A0\u3002\u57CE\u5899\u897F\u5357\u89D2\u57CE\u697C\u4E0A\u7684\u81FC\u70AE\u8FD8\u7B49\u7740\u4F60\u5462\u3002\n\n\u88C5\u597D\u4EE5\u540E\u518D\u53BB\u6C99\u6F20\u8BD5\u8BD5\u3002\u6309\u4E0B\u9065\u63A7\u5668\u5C31\u8DD1\u2014\u2014\u6211\u8981\u7684\u662F\u8BD5\u9A8C\u7ED3\u679C\uFF0C\u53EF\u4E0D\u662F\u66FF\u4F60\u5199\u60BC\u8BCD\u3002"
    differentActorOpeningText: 
    choices:
    - text: "\u518D\u89C1\u3002"
      action: 1
      nextNodeId: 
      effect: {fileID: 0}
      onSelected:
        m_PersistentCalls:
          m_Calls: []
  - id: stranger
    text: "\u4F60\u662F\u8C01\uFF1F\u6211\u53EF\u4E0D\u8BA4\u8BC6\u4F60\u3002\n\n\u6211\u8FD9\u91CC\u6CA1\u4EC0\u4E48\u4E1C\u897F\uFF0C\u53EA\u6709\u4E9B\u5E9F\u56FE\u7EB8\u548C\u574F\u96F6\u4EF6\u3002\u6CA1\u522B\u7684\u4E8B\u5C31\u8D70\u5427\uFF0C\u522B\u803D\u8BEF\u6211\u5E72\u6D3B\u3002"
    differentActorOpeningText: 
    choices:
    - text: "\u518D\u89C1\u3002"
      action: 1
      nextNodeId: 
      effect: {fileID: 0}
      onSelected:
        m_PersistentCalls:
          m_Calls: []
  - id: before_hunt
    text: "\u522B\u78B0\u684C\u4E0A\u7684\u96F6\u4EF6\uFF01\u4E0A\u56DE\u6709\u4EBA\u628A\u5B9A\u4F4D\u5668\u5F53\u9547\u7EB8\uFF0C\u5DEE\u70B9\u8BA9\u6211\u91CD\u753B\u534A\u4E2A\u6708\u7684\u56FE\u3002\n\n\u4F60\u82E5\u53EA\u662F\u968F\u4FBF\u901B\u901B\uFF0C\u5C31\u522B\u5728\u8FD9\u91CC\u788D\u624B\u788D\u811A\u3002\u57CE\u91CC\u5DF2\u7ECF\u8D34\u4E86\u6C99\u866B\u7684\u544A\u793A\uFF0C\u6253\u7B97\u51FA\u57CE\u4E4B\u524D\u5148\u53BB\u8BFB\u8BFB\u2014\u2014\u81F3\u5C11\u5F04\u6E05\u695A\u9EC4\u6C99\u4E0B\u9762\u6709\u4EC0\u4E48\uFF0C\u518D\u8C08\u4F60\u7684\u80C6\u91CF\u3002\n\n\u7B49\u4F60\u771F\u6709\u4E86\u5BF9\u4ED8\u90A3\u6761\u866B\u5B50\u7684\u6253\u7B97\uFF0C\u6216\u8BB8\u6211\u4EEC\u8FD8\u6709\u4E9B\u8BDD\u53EF\u8BF4\u3002"
