    - target: {fileID: 918620450781230005, guid: c76db960b6ca4cefa2a91739367713a5, type: 3}
      propertyPath: documentText
      value: "\u6CE8\u6DB2\u5668\u4F7F\u7528\u8BF4\u660E\n\n\u7ADE\u6280\u573A\u4E24\u4FA7\u7684\u6062\u590D\u6C60\u5206\u522B\u7531\u5404\u81EA\u7684\u6CE8\u6DB2\u5668\u4F9B\u6DB2\u3002\u9009\u4E2D\u7269\u54C1\u680F\u4E2D\u7684\u836F\u6C34\uFF0C\u9760\u8FD1\u4EFB\u610F\u4E00\u53F0\u88C5\u7F6E\u6309[E]\uFF0C\u5373\u53EF\u6CE8\u5165\u4E00\u74F6\u836F\u6C34\uFF0C\u5E76\u53D6\u56DE\u7A7A\u73BB\u7483\u74F6\u3002\n\n\u6CE8\u5165\u540E\uFF0C\u76F8\u8FDE\u6C34\u6C60\u5C06\u6539\u4E3A\u65BD\u52A0\u8BE5\u836F\u6C34\u7684\u6548\u679C\uFF0C\u8FDB\u5165\u5176\u4E2D\u7684\u89D2\u8272\u90FD\u4F1A\u53D7\u5230\u5F71\u54CD\u3002\u9650\u65F6\u6548\u679C\u5728\u6C60\u5185\u4E0D\u8BA1\u65F6\uFF0C\u79BB\u5F00\u540E\u624D\u5F00\u59CB\u5012\u8BA1\u65F6\uFF0C\u6301\u7EED\u65F6\u95F4\u4E3A\u901A\u5E38\u7684\u4E24\u500D\u3002\u518D\u6B21\u6CE8\u5165\u4F1A\u66FF\u6362\u539F\u6709\u6548\u679C\u3002\n\n\u5DE6\u6C60\u4F9B\u6311\u6218\u8005\u4F11\u6574\uFF0C\u53F3\u6C60\u4F9B\u5B88\u62A4\u8005\u5907\u6218\u3002\u8BF7\u6838\u5BF9\u74F6\u4E2D\u836F\u5242\u2014\u2014\u6C34\u6C60\u4E0D\u4F1A\u5206\u8FA8\u670B\u53CB\u4E0E\u5BF9\u624B\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 918620450781230005, guid: c76db960b6ca4cefa2a91739367713a5, type: 3}
      propertyPath: journalEntryId
      value: level2.arena.injection
      objectReference: {fileID: 0}
    - target: {fileID: 918620450781230005, guid: c76db960b6ca4cefa2a91739367713a5, type: 3}
      propertyPath: journalEntryTitle
      value: "\u4E3A\u4F60\u7684\u5065\u5EB7\u5E72\u676F"
      objectReference: {fileID: 0}
    - target: {fileID: 918620450781230005, guid: c76db960b6ca4cefa2a91739367713a5, type: 3}
      propertyPath: journalEntryDetails
      value: "\u5411\u6CE8\u6DB2\u5668\u6CE8\u5165\u836F\u6C34\uFF0C\u53EF\u4EE5\u6539\u53D8\u76F8\u8FDE\u6C34\u6C60\u65BD\u52A0\u7684\u6548\u679C\u3002\u7ADE\u6280\u573A\u5DE6\u4FA7\u6C34\u6C60\u4F9B\u6311\u6218\u8005\u4F7F\u7528\uFF0C\u53F3\u4FA7\u6C34\u6C60\u5F71\u54CD\u51FA\u573A\u5B88\u62A4\u8005\u7684\u6548\u679C\u3002\n\n\u5F53\u524D\u76EE\u6807\uFF1A\u5728\u7269\u54C1\u680F\u9009\u4E2D\u4EFB\u610F\u836F\u6C34\uFF0C\u5411\u7ADE\u6280\u573A\u65C1\u4EFB\u610F\u4E00\u53F0\u6CE8\u6DB2\u5668\u6CE8\u5165\u4E00\u74F6\u3002"
      objectReference: {fileID: 0}
