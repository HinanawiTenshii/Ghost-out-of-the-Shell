    text: "\u662F\u4F60\uFF01\u6211\u8BB0\u5F97\u4F60\u7AD9\u5230\u6700\u540E\u7684\u6837\u5B50\u3002\u5B88\u62A4\u8005\u5DF2\u7ECF\u8BA4\u53EF\u4F60\u7684\u672C\u9886\uFF0C\u8FD9\u679A\u8BD5\u70BC\u8BC1\u660E\u5C5E\u4E8E\u4F60\u3002\n\n\u62FF\u597D\u5B83\uFF0C\u53BB\u5411\u8BD5\u70BC\u5927\u95E8\u524D\u7684\u796D\u575B\u8BC1\u660E\u81EA\u5DF1\u5427\u3002"
    differentActorOpeningText: 
    choices:
    - text: "\u7A0D\u540E\u518D\u6765\u3002"
      action: 1
      nextNodeId: arena_claimed
      effect: {fileID: 0}
      onSelected:
        m_PersistentCalls:
          m_Calls: []
    - text: "\u9886\u53D6\u8BD5\u70BC\u8BC1\u660E\u3002"
      action: 0
      nextNodeId: arena_claimed
      effect: {fileID: 1465603231}
      onSelected:
        m_PersistentCalls:
          m_Calls: []
  - id: arena_claimed
    text: "\u8BC1\u660E\u5DF2\u7ECF\u4EA4\u5230\u4F60\u624B\u4E0A\u4E86\uFF0C\u672C\u5C4A\u6311\u6218\u4E5F\u5C31\u6B64\u7ED3\u675F\uFF0C\u4E0D\u518D\u63A5\u53D7\u62A5\u540D\u3002\n\n\u771F\u6B63\u7684\u8BD5\u70BC\u8FD8\u5728\u95E8\u540E\uFF0C\u613F\u4F60\u7684\u52C7\u6C14\u4E0D\u53EA\u7559\u5728\u8FD9\u5EA7\u7ADE\u6280\u573A\u91CC\u3002"
    differentActorOpeningText: 
    choices:
    - text: "\u518D\u89C1\u3002"
      action: 1
      nextNodeId: 
      effect: {fileID: 0}
      onSelected:
        m_PersistentCalls:
          m_Calls: []
  - id: arena_other
    text: "\u4ECA\u5929\u7684\u6311\u6218\u5DF2\u6709\u80DC\u8005\u3002\u8BC1\u660E\u53EA\u4EA4\u7ED9\u4EB2\u81EA\u5B8C\u6210\u6BD4\u8BD5\u7684\u90A3\u4F4D\u6311\u6218\u8005\uFF0C\u4E0D\u80FD\u8BA9\u522B\u4EBA\u4EE3\u9886\u3002"
    differentActorOpeningText: 
    choices:
    - text: "\u518D\u89C1\u3002"
      action: 1
      nextNodeId: 
      effect: {fileID: 0}
      onSelected:
        m_PersistentCalls:
          m_Calls: []
  - id: arena_retry
    text: "\u53EF\u60DC\u4E86\u2026\u2026\u4E0A\u4E00\u4F4D\u80DC\u8005\u8FD8\u6CA1\u6765\u9886\u53D6\u8BC1\u660E\uFF0C\u5C31\u5DF2\u8EAB\u6545\u3002\u8363\u8000\u4E0D\u80FD\u7531\u65C1\u4EBA\u4EE3\u9886\uFF0C\u90A3\u4EFD\u53C2\u8D5B\u8BB0\u5F55\u5DF2\u7ECF\u4F5C\u5E9F\u3002\n\n\u8BC1\u660E\u4ECD\u5728\u6211\u8FD9\u91CC\uFF0C\u7ADE\u6280\u573A\u91CD\u65B0\u63A5\u53D7\u62A5\u540D\u3002\u82E5\u4F60\u4E5F\u60F3\u5F97\u5230\u5B83\uFF0C\u5C31\u4EB2\u81EA\u6218\u80DC\u6240\u6709\u5B88\u62A4\u8005\u3002\u4F60\u51C6\u5907\u597D\u4E86\u5417\uFF1F"
    differentActorOpeningText: 
