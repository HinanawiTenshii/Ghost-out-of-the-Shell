--- !u!114 &1785837441
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1785837440}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5611d3acb49e8a0e731fca88a298d4e7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  speakerName: "\u5B88\u5893\u4EBA"
  startNodeId: start
  questProgression: {fileID: 1785837444}
  actorAgreement: {fileID: 0}
  arenaChallenge: {fileID: 0}
  dialogueMemoryId: level2.gravekeeper.dialogue
  interactionDistance: 1.8
  displayFont: {fileID: 12800000, guid: 292af55397c443f6a5d7774297dac481, type: 3}
  dimOpacity: 0.65
  nodes:
  - id: start
    text: "\u522B\u5F80\u57CB\u9AA8\u5730\u6DF1\u5904\u8D70\u3002\u90A3\u4E9B\u4E0B\u846C\u7684\u4EBA\u53C8\u7AD9\u8D77\u6765\u4E86\uFF0C\u6253\u788E\u4E86\u8FD8\u4F1A\u91CD\u65B0\u62FC\u597D\u3002\n\n\u539F\u672C\u7528\u6765\u5B89\u629A\u4EA1\u8005\u7684\u9547\u629A\u6C34\u6676\u53D7\u4E86\u6C61\u67D3\u3002\u53EA\u8981\u5B83\u8FD8\u4EAE\u7740\uFF0C\u6B7B\u8005\u5C31\u4E0D\u5F97\u5B89\u5B81\u3002\u6211\u5B88\u4E86\u4E00\u8F88\u5B50\u5893\uFF0C\u5374\u8FDE\u8BA9\u4ED6\u4EEC\u597D\u597D\u8EBA\u7740\u90FD\u529E\u4E0D\u5230\u3002\n\n\u4F60\u82E5\u613F\u610F\u628A\u90A3\u9897\u6C34\u6676\u6BC1\u6389\uFF0C\u6211\u5C31\u544A\u8BC9\u4F60\u6559\u5802\u4E8C\u697C\u5723\u7269\u95F4\u7684\u5BC6\u7801\u3002\u90A3\u5730\u65B9\u6211\u4ECE\u524D\u53BB\u8FC7\uFF0C\u5BC6\u7801\u8FD8\u8BB0\u5F97\u3002\u600E\u4E48\u6837\uFF0C\u80AF\u5E2E\u8FD9\u4E2A\u5FD9\u5417\uFF1F"
    differentActorOpeningText: 
    choices:
    - text: "\u518D\u89C1\u3002"
      action: 1
      nextNodeId: 
      effect: {fileID: 0}
      onSelected:
        m_PersistentCalls:
          m_Calls: []
    - text: "\u6211\u53BB\u6467\u6BC1\u6C34\u6676\u3002"
      action: 0
      nextNodeId: waiting
      effect: {fileID: 1785837442}
      onSelected:
        m_PersistentCalls:
          m_Calls: []
  - id: waiting
    text: "\u57CB\u9AA8\u5730\u90A3\u9897\u53D7\u6C61\u67D3\u7684\u9547\u629A\u6C34\u6676\uFF0C\u5DF2\u7ECF\u6BC1\u6389\u4E86\u5417\uFF1F\n\n\u522B\u53EA\u987E\u7740\u6253\u90A3\u4E9B\u9AB7\u9AC5\u3002\u6C34\u6676\u8FD8\u5728\uFF0C\u5B83\u4EEC\u5C31\u4F1A\u4E00\u6B21\u6B21\u590D\u539F\u3002\u7B49\u4F60\u628A\u6C34\u6676\u6BC1\u6389\uFF0C\u6211\u7B54\u5E94\u7684\u5BC6\u7801\u4E00\u5B9A\u544A\u8BC9\u4F60\u3002"
    differentActorOpeningText: "\u4F60\u4E0D\u662F\u4E0A\u6B21\u7B54\u5E94\u5E2E\u5FD9\u7684\u90A3\u4E2A\u4EBA\u3002\u662F\u4ED6\u8BF7\u4F60\u6765\u7684\uFF1F\n\n\u65E2\u7136\u4F60\u4E5F\u77E5\u9053\u8FD9\u4EF6\u4E8B\uFF0C\u6211\u5C31\u4E0D\u591A\u95EE\u4E86\u3002\u57CB\u9AA8\u5730\u88AB\u6C61\u67D3\u7684\u9547\u629A\u6C34\u6676\u6BC1\u6389\u4E86\u5417\uFF1F\u53EA\u8981\u90A3\u4E1C\u897F\u4E0D\u518D\u8BA9\u6B7B\u8005\u590D\u6D3B\uFF0C\u6211\u7B54\u5E94\u7684\u5BC6\u7801\u7167\u6837\u7B97\u6570\u3002"
    choices:
    - text: "\u518D\u89C1\u3002"
      action: 1
      nextNodeId: 
      effect: {fileID: 0}
      onSelected:
        m_PersistentCalls:
          m_Calls: []
    - text: "\u88AB\u6C61\u67D3\u7684\u6C34\u6676\u5DF2\u7ECF\u88AB\u6467\u6BC1\u4E86\u3002"
      action: 0
      nextNodeId: finished
      effect: {fileID: 1785837443}
      onSelected:
        m_PersistentCalls:
          m_Calls: []
  - id: finished
    text: "\u7EC8\u4E8E\u2026\u2026\u4ED6\u4EEC\u603B\u7B97\u80FD\u5B89\u9759\u4E9B\u4E86\u3002\u8C22\u8C22\u4F60\u3002\n\n\u8BF4\u597D\u7684\u62A5\u916C\uFF1A\u6559\u5802\u4E8C\u697C\u5723\u7269\u95F4\uFF0C\u5BC6\u7801\u662F7028\u3002\u8BB0\u6E05\u695A\uFF0C\u4E03\u3001\u96F6\u3001\u4E8C\u3001\u516B\u3002\n\n\u4E0D\u8FC7\uFF0C\u77E5\u9053\u5BC6\u7801\u8FD8\u4E0D\u591F\u3002\u8981\u62FF\u5230\u5723\u7269\uFF0C\u4F60\u8FD8\u5F97\u627E\u5230\u5723\u7269\u95F4\u94A5\u5319\u3002\u6211\u80FD\u544A\u8BC9\u4F60\u7684\u53EA\u6709\u8FD9\u4E9B\uFF0C\u5269\u4E0B\u7684\u5C31\u770B\u4F60\u81EA\u5DF1\u4E86\u3002"
    differentActorOpeningText: "\u4F60\u548C\u4E0A\u56DE\u6765\u62A5\u4FE1\u7684\u4EBA\u4E0D\u662F\u540C\u4E00\u4E2A\u4EBA\u3002\u6C34\u6676\u5DF2\u7ECF\u6BC1\u4E86\uFF0C\u8FD9\u4EFD\u4EBA\u60C5\u6211\u4E0D\u4F1A\u8D56\u6389\u3002\n\n\u82E5\u4F60\u4E5F\u662F\u6765\u95EE\u5723\u7269\u95F4\u7684\u4E8B\uFF0C\u8BB0\u4F4F\uFF1A\u6559\u5802\u4E8C\u697C\uFF0C\u5BC6\u78017028\u3002\u4E0D\u8FC7\u8981\u53D6\u5F97\u91CC\u9762\u7684\u5723\u7269\uFF0C\u8FD8\u5F97\u6709\u5723\u7269\u95F4\u94A5\u5319\u3002\u522B\u4EE5\u4E3A\u53EA\u77E5\u9053\u5BC6\u7801\u5C31\u80FD\u62FF\u5230\u4E1C\u897F\u3002"
    choices:
    - text: "\u518D\u89C1\u3002"
      action: 1
      nextNodeId: 
      effect: {fileID: 0}
      onSelected:
        m_PersistentCalls:
          m_Calls: []
