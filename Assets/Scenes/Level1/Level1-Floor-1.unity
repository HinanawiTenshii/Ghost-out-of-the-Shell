    - target: {fileID: 918620450781230005, guid: c76db960b6ca4cefa2a91739367713a5, type: 3}
      propertyPath: documentText
      value: "\u7ED9\u540C\u8C0B\u7684\u4FBF\u6761\n\n\u90A3\u5934\u5DE8\u517D\u8FDE\u57CE\u5899\u90FD\u62C6\u5F97\u5F00\uFF0C\u7ADF\u6CA1\u80FD\u66FF\u6211\u4EEC\u529E\u6210\u8FD9\u6869\u523A\u6740\u3002\u522B\u518D\u628A\u5E0C\u671B\u5168\u62BC\u5728\u5B83\u8EAB\u4E0A\uFF0C\u6211\u4EEC\u8FD8\u6709\u53E6\u4E00\u624B\u3002\n\n\u627E\u9F50[\u5F15\u4FE1]\u3001[\u8D85\u7EA7\u70B8\u5F39\u5916\u58F3]\u548C[\u9B54\u529B\u706B\u836F]\uFF0C\u62FF\u5230\u8FD9\u5F20\u4FBF\u6761\u65C1\u7684\u5DE5\u4F5C\u53F0\u7EC4\u88C5\u3002\u505A\u51FA\u7684\u8D85\u7EA7\u70B8\u5F39\uFF0C\u5A01\u529B\u8DB3\u591F\u8F70\u5F00\u57CE\u5821\u5927\u95E8\u3002\n\n\u7B49\u4E1C\u897F\u5907\u59A5\uFF0C\u518D\u8BAE\u57CB\u4F0F\u7684\u65F6\u673A\u3002\u56FD\u738B\u4E0D\u4F1A\u6C38\u8FDC\u5F85\u5728\u623F\u91CC\uFF0C\u603B\u6709\u4E00\u6B21\uFF0C\u4ED6\u5F97\u4ECE\u90A3\u6247\u95E8\u524D\u7ECF\u8FC7\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 918620450781230005, guid: c76db960b6ca4cefa2a91739367713a5, type: 3}
      propertyPath: journalEntryId
      value: level1.craft_super_bomb
